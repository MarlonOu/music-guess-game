# 複製此檔為 .env（已列入 .gitignore，不會進版控），並填入自己的金鑰／連線字串。

# Postgres 連線字串，供 Prisma 使用（歌手／歌曲題庫）。
# 依 06-environment-setup.md 建立 game_dev 使用者與 music_guess_game 資料庫後填入。
DATABASE_URL="postgresql://game_dev:設定密碼@localhost:5432/music_guess_game"

# YouTube Data API v3 金鑰，供 scripts/populate-youtube-ids.mjs 查詢真實影片 ID 使用。
# 取得方式：Google Cloud Console → 建立專案 → 啟用「YouTube Data API v3」→ 建立憑證（API 金鑰）
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# 管理頁面（/admin）與相關管理用 API 的 HTTP Basic Auth 帳密。
# 未設定時 middleware.ts 會直接停用整段管理功能（回傳 503），不會預設放行。
# 上架給外部使用者測試前務必設定，避免任何人都能改題庫、消耗你的 YouTube API 配額。
ADMIN_USER=
ADMIN_PASSWORD=
